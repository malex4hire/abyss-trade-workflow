#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")"

if [ ! -f .env ]; then
    if ! command -v openssl >/dev/null 2>&1; then
        echo 'Copy .env.example to .env and set a demo token.' >&2
        exit 1
    fi
    umask 077
    printf 'DEMO_TOKEN=%s\n' "$(openssl rand -hex 24)" > .env
fi

docker compose up --build -d
printf '%s\n' \
    'Portal: http://localhost:13000' \
    'API health: http://localhost:18080/health' \
    'OpenAPI docs: http://localhost:18081' \
    'Use the DEMO_TOKEN value in .env to unlock the portal.'
